{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/avaliacao",
      "dest": "/avaliacao.html"
    },
    {
      "src": "/expresso",
      "dest": "/expresso.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
